  1. LINEAR interpolation

      import numpy as np
      x = np.array([1, 2, 3, 4, 5])
      y = np.array([2, 4, 5, 4, 6])
      import matplotlib.pyplot as plt
      plt.scatter(x, y)

      x_new = np.linspace(1, 5, 10) # generate 10 evenly spaced points between 1 and 5
      y_interp = np.interp(x_new, x, y) # interpolate y values at x_new points
      print(y_interp)
      plt.scatter(x_new, y_interp)

  2. CUBIC interpolation

      import numpy as np
      x = np.array([1, 2, 3, 4, 5])
      y = np.array([2, 16, 36, 64, 125])
      from scipy.interpolate import interp1d
      # create a cubic interpolation function
      f = interp1d(x, y, kind='cubic')
      x_new = np.linspace(1, 5, 10)
      y_interp = f(x_new)
      print(y_interp)
      import matplotlib.pyplot as plt
      plt.scatter(x, y)
      plt.scatter(x_new, y_interp)
      plt.show()

  3. POLYNOMIAL interpolation

      x = np.array([1, 2, 3, 4, 5])
      y = np.array([2, 16, 36, 64, 125])
      p = np.polyfit(x, y, 2) # fit a 2nd degree polynomial to the data
      x_new = np.linspace(1, 5, 10)
      y_interp = np.polyval(p, x_new) # evaluate the polynomial at the new points
      plt.scatter(x, y)
      plt.scatter(x_new, y_interp)
      plt.show()
